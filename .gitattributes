# languages/ pack files carry pre-decided byte content (cp1250 text, GoldSrc
# .ent format, tab-separated manifests) that must never be touched by
# autocrlf line-ending conversion, whatever core.autocrlf is set to locally.
languages/**/*.ent -text
languages/**/*.tsv -text
languages/**/*.txt -text
languages/**/*.entpatch -text
# LICENSE-NOTE.md is listed (with its SHA-256) in each pack's MANIFEST.tsv, so it
# must keep its exact bytes as well.
languages/**/LICENSE-NOTE.md -text
# Batch files must keep CRLF line endings or cmd.exe misreads labels.
release/installer/*.cmd text eol=crlf
