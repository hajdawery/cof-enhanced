diff --git a/engine/server/sv_client.c b/engine/server/sv_client.c
--- a/engine/server/sv_client.c
+++ b/engine/server/sv_client.c
@@ -3086,7 +3086,16 @@ static void SV_ExecuteClientCommand( sv_client_t *cl, const char *s )
 {
 	int i;
+	qboolean cofload = false;
+	char cofload_slot[2] = { '\0', '\0' };
 
 	Cmd_TokenizeString( s );
+	cofload = ( Cmd_Argc() == 2 && !Q_stricmp( Cmd_Argv( 0 ), "cofload" ) &&
+		Cmd_Argv( 1 )[0] >= '1' && Cmd_Argv( 1 )[0] <= '5' && Cmd_Argv( 1 )[1] == '\0' );
+	if( cofload )
+		cofload_slot[0] = Cmd_Argv( 1 )[0];
+	if( cofload && Cvar_VariableInteger( "cof_trace_menu_load" ))
+		Con_Reportf( "[cof-trace] server received cofload %s client_state=%d server_state=%d\n",
+			Cmd_Argv( 1 ), cl->state, sv.state );
 
 	for( i = 0; i < ARRAYSIZE( ucmds ); i++ )
 	{
@@ -3137,4 +3145,6 @@ static void SV_ExecuteClientCommand( sv_client_t *cl, const char *s )
 		// custom client commands
 		svgame.dllFuncs.pfnClientCommand( cl->edict );
+		if( cofload && Cvar_VariableInteger( "cof_trace_menu_load" ))
+			Con_Reportf( "[cof-trace] hl ClientCommand returned for cofload %s\n", cofload_slot );
 
 		if( fullupdate )
@@ -3676,7 +3686,10 @@ void SV_ParseClientMessage( sv_client_t *cl, sizebuf_t *msg )
 			break;
 		case clc_stringcmd:
 		{
-			SV_ExecuteClientCommand( cl, MSG_ReadString( msg ));
+			const char *stringcmd = MSG_ReadString( msg );
+			if( Cvar_VariableInteger( "cof_trace_menu_load" ) && !Q_strnicmp( stringcmd, "cofload ", 8 ))
+				Con_Reportf( "[cof-trace] clc_stringcmd cofload packet: %s\n", stringcmd );
+			SV_ExecuteClientCommand( cl, stringcmd );
 		}
 			if( cl->state == cs_zombie )
 				return; // disconnect command
diff --git a/engine/server/sv_game.c b/engine/server/sv_game.c
--- a/engine/server/sv_game.c
+++ b/engine/server/sv_game.c
@@ -2320,9 +2320,15 @@ pfnServerCommand
 */
 static void GAME_EXPORT pfnServerCommand( const char* str )
 {
+	qboolean cofload = ( str && !Q_strnicmp( str, "load cofsave", 12 ) &&
+		str[12] >= '1' && str[12] <= '5' );
+	if( cofload && Cvar_VariableInteger( "cof_trace_menu_load" ))
+		Con_Reportf( "[cof-trace] hl pfnServerCommand: %s\n", str );
 
 	if( !SV_IsValidCmd( str ))
 	{
+		if( cofload && Cvar_VariableInteger( "cof_trace_menu_load" ))
+			Con_Reportf( "[cof-trace] hl pfnServerCommand rejected\n" );
 		Con_Printf( S_ERROR "bad server command %s\n", str );
 	}
 	else Cbuf_AddText( str );
