+/*
+=================
+UI_CoFUnlockableStatus
+
+The documented hook for real unlock state. There is no flag source today:
+cryoffear/scriptsettings.dat is 101 fixed-width obfuscated tokens compared
+against a table of 34 paired constants compiled into client.dll, and the
+token-to-item mapping is unresolved (research section 1.3, explicitly open).
+The client exposes no command or cvar that reports a single unlock either.
+
+Return -1 for unknown, 0 for locked, 1 for unlocked. When a source appears -
+an engine export, a client command, or a decoded scriptsettings.dat - this is
+the only function the page needs.
+=================
+*/
+int UI_CoFUnlockableStatus( int index )
+{
+	if( index < 0 || index >= COF_NUM_UNLOCKABLES )
+		return -1;
+
+	// the one flag the project already mirrors, and only because the difficulty
+	// page needs it; it is a stand-in cvar, not the client's own byte
+	if( index == 18 ) // Nightmare mode
+		return EngFuncs::GetCvarFloat( "cof_nightmare_unlocked" ) != 0.0f ? 1 : 0;
+
+	return -1;
+}
