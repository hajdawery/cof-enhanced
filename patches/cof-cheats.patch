+GNU General Public License for more details.
+
+Cry of Fear 1.6 removed its developer cheats in its own engine (hw.dll), which
+Xash replaces, and it resets or ignores the stock engine ones in its game DLL:
+CBasePlayer::PostThink puts MOVETYPE_NOCLIP back to MOVETYPE_WALK every frame,
+thirteen places clear FL_NOTARGET, CBasePlayer::TakeDamage never looks at
+FL_GODMODE and there is no "give". What the game DLL still has are dead
+developer switches and plain data in the player object that a runtime write
+turns on. See cof-fix/docs/cof-cheats.md for every command, the offsets and
+where they come from.
+
+Everything here is gated twice:
+  * sv_cheats 1 (and a real, non-background game), and
+  * the loaded server DLL must be the retail Cry of Fear 1.6 hl.dll, checked by
+    SHA-256 of the module file, because every offset below is specific to that
+    build. Anything else gets the stock engine behaviour back, and the cof_*
+    commands refuse with one line.
+Every write re-validates the player edict, its private data allocation, the
+allocation size and the CBaseEntity::pev back-pointer, and checks that the
+value it replaces is one the retail game can hold; anything unexpected is
+refused rather than written.
+*/
+
+#include "common.h"
+#include "server.h"
+#include "const.h"
+#include "library.h"
+#include "sv_cof_cheats.h"
+#include <stddef.h>
+#if XASH_WIN32
+#include <windows.h>
+#endif
+
+#if XASH_WIN32 && XASH_X86 && defined( XASH_COF_ENTVARS_LEGACY ) && XASH_COF_ENTVARS_LEGACY
+#define COF_CHEATS_SUPPORTED 1
+// the CoF entvars layout the retail DLL was built against: movetype is before
+// the four-byte legacy gap, flags and air_finished after it
+STATIC_ASSERT( offsetof( entvars_t, movetype ) == 0x108, "CoF entvars: movetype" );
+STATIC_ASSERT( offsetof( entvars_t, flags ) == 0x1A8, "CoF entvars: flags" );
+STATIC_ASSERT( offsetof( entvars_t, air_finished ) == 0x200, "CoF entvars: air_finished" );
+#else
+#define COF_CHEATS_SUPPORTED 0
+#endif
+
+// SHA-256 of cryoffear/cl_dlls/hl.dll as shipped by Cry of Fear 1.6 (Steam)
+static const char cof_retail_hl_sha256[] = "0036b91c01e92ed205513f52563053a55a66a32d257efb5f476b8f1f3dde0e63";
+
+/*
+=============================================================================
+
+CBasePlayer / CInterDoor member offsets in the retail 1.6 hl.dll
+
+Offsets from CBaseEntity* == edict->pvPrivateData (vtable at +0, pev at +4),
+taken from the DLL's own TYPEDESCRIPTION save tables (player table at
+VA 10217FE8) and from the code that reads them; see docs/cof-cheats.md.
+
+=============================================================================
+*/
+#define COF_PV_PEV                  0x0004 // entvars_t *pev
+#define COF_PV_TOUCH                0x007C // CBaseEntity::m_pfnTouch
+#define COF_PV_USE                  0x0080 // CBaseEntity::m_pfnUse
+#define COF_PL_HAS_NIGHTVISION      0x0434 // bool m_bHasNightVision
+#define COF_PL_ENDING_ROOFBOSS      0x04CD // bool m_b_Ending_RoofBossKilled
+#define COF_PL_ENDING_GIVENP345     0x04CE // bool m_b_Ending_GivenP345
+#define COF_PL_ENDING_DELIVERED     0x04CF // bool m_b_Ending_DeliveredPackage
+#define COF_PL_GOING_THROUGH_DOOR   0x1EA4 // bool b_GoingThroughADoor
+#define COF_PL_TAPES                0x1EF4 // int  m_iTapes
+#define COF_PL_INFINITE_STAMINA     0x21E8 // bool m_bInfiniteStamina
+#define COF_PL_INFINITE_AMMO        0x21EA // bool m_bInfiniteAmmo
+#define COF_PL_STAMINA              0x21F0 // float m_fStamina (read only, for the status line)
+#define COF_PL_HEADSHIELD           0x2300 // int  m_iHeadShieldOn (nightvision state)
+#define COF_PL_MIN_SIZE             0x2304 // the player object must be at least this big
+
+// m_iHeadShieldOn: 0 off, 1 on, 0x65 "turn on" and 0x64 "turn off" requests
+// that CBasePlayer::PostThink completes on its next run (retail 100EB92A/100EBB23)
+#define COF_NV_OFF       0
+#define COF_NV_ON        1
+#define COF_NV_REQ_OFF   0x64
+#define COF_NV_REQ_ON    0x65
+
+#define COF_TAPES_MAX    999
+
+typedef struct cof_lock_desc_s
+{
+	const char *classname;
+	int         locked_by; // string_t m_sLockedBy
+	int         locked_msg; // string_t m_sLockedMsg
+} cof_lock_desc_t;
+
+static const cof_lock_desc_t cof_lock_descs[] =
+{
+{ "inter_door",      0x190, 0x194 },
+{ "inter_door_coop", 0x114, 0x118 },
+{ "func_valve",      0x180, 0x184 },
+};
