+/*
+=============================================================================
+
+engine-side state
+
+=============================================================================
+*/
+typedef struct cof_latch_s
+{
+	qboolean noclip;
+	qboolean notarget;
+	qboolean fly;
+	qboolean infammo;
+	qboolean infstamina;
+	qboolean nodamage;
+	qboolean nodrown;
+} cof_latch_t;
+
+// per client slot, engine memory only: it outlives changelevel and load, and
+// is re-applied onto whatever player object the slot has after either
+static cof_latch_t cof_latches[MAX_CLIENTS];
+
+typedef enum
+{
+	COF_HASH_UNCHECKED = 0,
+	COF_HASH_MATCH,
+	COF_HASH_MISMATCH,
+	COF_HASH_UNREADABLE,
+	COF_HASH_UNSUPPORTED,
+} cof_hash_state_t;
+
+static struct
+{
+	const void       *instance; // svgame.hInstance the result belongs to
+	cof_hash_state_t state;
+	char             hex[65];
+} cof_hash;
+
+/*
+=============================================================================
+
+SHA-256 (FIPS 180-4), only used to identify the loaded game DLL
+
+=============================================================================
+*/
+typedef struct cof_sha256_s
+{
+	uint32_t state[8];
+	uint64_t length;
+	byte     block[64];
+	size_t   fill;
+} cof_sha256_t;
+
+static const uint32_t cof_sha256_k[64] =
+{
+0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+};
+
+#define COF_ROR32( x, n ) ((( x ) >> ( n )) | (( x ) << ( 32 - ( n ))))
+
+static void CoF_Sha256Block( cof_sha256_t *ctx, const byte *p )
+{
+	uint32_t w[64], a, b, c, d, e, f, g, h;
+	int i;
+
+	for( i = 0; i < 16; i++ )
+		w[i] = ((uint32_t)p[i * 4] << 24 ) | ((uint32_t)p[i * 4 + 1] << 16 ) | ((uint32_t)p[i * 4 + 2] << 8 ) | p[i * 4 + 3];
+
+	for( i = 16; i < 64; i++ )
+	{
+		uint32_t s0 = COF_ROR32( w[i - 15], 7 ) ^ COF_ROR32( w[i - 15], 18 ) ^ ( w[i - 15] >> 3 );
+		uint32_t s1 = COF_ROR32( w[i - 2], 17 ) ^ COF_ROR32( w[i - 2], 19 ) ^ ( w[i - 2] >> 10 );
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = ctx->state[0]; b = ctx->state[1]; c = ctx->state[2]; d = ctx->state[3];
+	e = ctx->state[4]; f = ctx->state[5]; g = ctx->state[6]; h = ctx->state[7];
+
+	for( i = 0; i < 64; i++ )
+	{
+		uint32_t s1 = COF_ROR32( e, 6 ) ^ COF_ROR32( e, 11 ) ^ COF_ROR32( e, 25 );
+		uint32_t ch = ( e & f ) ^ ( ~e & g );
+		uint32_t t1 = h + s1 + ch + cof_sha256_k[i] + w[i];
+		uint32_t s0 = COF_ROR32( a, 2 ) ^ COF_ROR32( a, 13 ) ^ COF_ROR32( a, 22 );
+		uint32_t maj = ( a & b ) ^ ( a & c ) ^ ( b & c );
+		uint32_t t2 = s0 + maj;
+
+		h = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+
+	ctx->state[0] += a; ctx->state[1] += b; ctx->state[2] += c; ctx->state[3] += d;
+	ctx->state[4] += e; ctx->state[5] += f; ctx->state[6] += g; ctx->state[7] += h;
+}
+
+static void CoF_Sha256Init( cof_sha256_t *ctx )
+{
+	static const uint32_t iv[8] =
+	{
+	0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+	};
+
+	memcpy( ctx->state, iv, sizeof( iv ));
+	ctx->length = 0;
+	ctx->fill = 0;
+}
+
+static void CoF_Sha256Update( cof_sha256_t *ctx, const byte *data, size_t len )
+{
+	ctx->length += len;
+
+	while( len > 0 )
+	{
+		size_t n = Q_min( len, sizeof( ctx->block ) - ctx->fill );
+
+		memcpy( ctx->block + ctx->fill, data, n );
+		ctx->fill += n;
+		data += n;
+		len -= n;
+
+		if( ctx->fill == sizeof( ctx->block ))
+		{
+			CoF_Sha256Block( ctx, ctx->block );
+			ctx->fill = 0;
+		}
+	}
+}
+
+static void CoF_Sha256Final( cof_sha256_t *ctx, char hex[65] )
+{
+	uint64_t bits = ctx->length * 8;
+	byte pad = 0x80, len[8];
+	int i;
+
+	CoF_Sha256Update( ctx, &pad, 1 );
+	pad = 0;
+	while( ctx->fill != 56 )
+		CoF_Sha256Update( ctx, &pad, 1 );
+
+	for( i = 0; i < 8; i++ )
+		len[i] = (byte)( bits >> ( 56 - i * 8 ));
+	CoF_Sha256Update( ctx, len, 8 );
+
+	for( i = 0; i < 32; i++ )
+	{
+		static const char digits[] = "0123456789abcdef";
+		byte v = (byte)( ctx->state[i >> 2] >> ( 24 - ( i & 3 ) * 8 ));
+
+		hex[i * 2] = digits[v >> 4];
+		hex[i * 2 + 1] = digits[v & 15];
+	}
+	hex[64] = '\0';
+}
+
+/*
+=============================================================================
+
+game DLL identity
+
+=============================================================================
+*/
+#if COF_CHEATS_SUPPORTED
+static cof_hash_state_t CoF_HashModuleFile( const dll_user_t *hInst, char hex[65] )
+{
+	wchar_t path[2048];
+	cof_sha256_t ctx;
+	byte buf[16384];
+	size_t n;
+	FILE *f;
+
+	path[0] = 0;
+
+	// the file the loader actually mapped; the loader's own resolved path is
+	// the fallback (and the only answer for the in-memory loader)
+	if( !hInst->custom_loader && hInst->hInstance )
+	{
+		DWORD len = GetModuleFileNameW((HMODULE)hInst->hInstance, path, ARRAYSIZE( path ));
+
+		if( len == 0 || len >= ARRAYSIZE( path ))
+			path[0] = 0;
+	}
+
+	if( !path[0] && !MultiByteToWideChar( CP_UTF8, 0, hInst->fullPath, -1, path, ARRAYSIZE( path )))
+		return COF_HASH_UNREADABLE;
+
+	f = _wfopen( path, L"rb" );
+	if( !f )
+		return COF_HASH_UNREADABLE;
+
+	CoF_Sha256Init( &ctx );
+	while(( n = fread( buf, 1, sizeof( buf ), f )) > 0 )
+		CoF_Sha256Update( &ctx, buf, n );
+
+	if( ferror( f ))
+	{
+		fclose( f );
+		return COF_HASH_UNREADABLE;
+	}
+
+	fclose( f );
+	CoF_Sha256Final( &ctx, hex );
+
+	return !Q_strcmp( hex, cof_retail_hl_sha256 ) ? COF_HASH_MATCH : COF_HASH_MISMATCH;
+}
+#endif // COF_CHEATS_SUPPORTED
+
+static cof_hash_state_t CoF_GameDllState( void )
+{
+	if( !svgame.hInstance )
+		return COF_HASH_UNREADABLE;
+
+	// hashed once per loaded game DLL
+	if( cof_hash.state != COF_HASH_UNCHECKED && cof_hash.instance == svgame.hInstance )
+		return cof_hash.state;
+
+	cof_hash.instance = svgame.hInstance;
+	cof_hash.hex[0] = '\0';
+
+#if COF_CHEATS_SUPPORTED
+	cof_hash.state = CoF_HashModuleFile((const dll_user_t *)svgame.hInstance, cof_hash.hex );
+#else
+	cof_hash.state = COF_HASH_UNSUPPORTED;
+#endif
+
+	switch( cof_hash.state )
+	{
+	case COF_HASH_MATCH:
+		Con_Reportf( "cof cheats: server DLL is the retail Cry of Fear 1.6 hl.dll (sha256 %s)\n", cof_hash.hex );
+		break;
+	case COF_HASH_MISMATCH:
+		Con_Reportf( "cof cheats: server DLL sha256 %s is not the retail Cry of Fear 1.6 hl.dll, cof cheats stay off\n", cof_hash.hex );
+		break;
+	case COF_HASH_UNREADABLE:
+		Con_Reportf( "cof cheats: could not read the server DLL to identify it, cof cheats stay off\n" );
+		break;
+	default:
+		Con_Reportf( "cof cheats: this engine build cannot carry the cof cheats (needs Win32 x86 with the CoF entvars layout)\n" );
+		break;
+	}
+
+	return cof_hash.state;
+}
+
+static const char *CoF_HashRefusal( cof_hash_state_t state )
+{
+	switch( state )
+	{
+	case COF_HASH_MISMATCH:   return "the loaded hl.dll is not the retail Cry of Fear 1.6 build (offsets unknown)";
+	case COF_HASH_UNREADABLE: return "the loaded hl.dll could not be read to identify it";
+	default:                  return "this engine build does not support the Cry of Fear cheats";
+	}
+}
+
+/*
+=============================================================================
+
+validated access to the player object
+
+=============================================================================
+*/
+typedef struct cof_player_s
+{
+	edict_t *ent;
+	byte    *pv;
+	size_t  size;
+} cof_player_t;
+
+// last validated private data per slot, so the per-frame path does not walk
+// the allocation chain every frame (the edict's own pvPrivateData changes on
+// every load and changelevel, which invalidates this)
+static struct
+{
+	const void *pv;
+	size_t      size;
+} cof_pvcache[MAX_CLIENTS];
+
+static size_t CoF_PrivateDataSize( int slot, const void *pv )
+{
+	size_t size;
+
+	if( slot >= 0 && slot < MAX_CLIENTS && cof_pvcache[slot].pv == pv && pv != NULL )
+		return cof_pvcache[slot].size;
+
+	size = Mem_AllocatedSize( svgame.mempool, (void *)pv );
+
+	if( slot >= 0 && slot < MAX_CLIENTS )
+	{
+		cof_pvcache[slot].pv = size ? pv : NULL;
+		cof_pvcache[slot].size = size;
+	}
+
+	return size;
+}
+
+// an entity's private data: allocated by the engine for this edict, big enough
+// and pointing back at this edict's entvars
+static byte *CoF_EntityPrivate( edict_t *ent, int slot, size_t need, size_t *outsize )
+{
+	byte *pv;
+	size_t size;
+
+	if( !SV_IsValidEdict( ent ) || !ent->pvPrivateData )
+		return NULL;
+
+	pv = (byte *)ent->pvPrivateData;
+	size = CoF_PrivateDataSize( slot, pv );
+
+	if( size < need )
+		return NULL;
+
+	if( *(entvars_t **)( pv + COF_PV_PEV ) != &ent->v )
+		return NULL;
+
+	if( outsize )
+		*outsize = size;
+
+	return pv;
+}
+
+static int CoF_ClientSlot( const sv_client_t *cl )
+{
+	int slot = (int)( cl - svs.clients );
+
+	if( slot < 0 || slot >= svs.maxclients || slot >= MAX_CLIENTS )
+		return -1;
+	return slot;
+}
+
+static qboolean CoF_GetPlayer( sv_client_t *cl, cof_player_t *p )
+{
+	int slot = CoF_ClientSlot( cl );
+	edict_t *ent;
+
+	memset( p, 0, sizeof( *p ));
+
+	if( slot < 0 || cl->state != cs_spawned || sv.state != ss_active )
+		return false;
+
+	ent = cl->edict;
+	if( !SV_IsValidEdict( ent ) || Q_strcmp( SV_GetString( ent->v.classname ), "player" ))
+		return false;
+
+	p->pv = CoF_EntityPrivate( ent, slot, COF_PL_MIN_SIZE, &p->size );
+	if( !p->pv )
+		return false;
+
+	p->ent = ent;
+	return true;
+}
+
+static qboolean CoF_ReadBool( const cof_player_t *p, int ofs, byte *out )
+{
+	if( ofs < 0 || (size_t)ofs + 1 > p->size )
+		return false;
+
+	*out = p->pv[ofs];
+	return *out <= 1; // a C++ bool the game wrote is 0 or 1, anything else is not our field
+}
+
+static qboolean CoF_WriteBool( const cof_player_t *p, int ofs, qboolean value )
+{
+	byte cur;
+
+	if( !CoF_ReadBool( p, ofs, &cur ))
+		return false;
+
+	if( cur != ( value ? 1 : 0 ))
+		p->pv[ofs] = value ? 1 : 0;
+	return true;
+}
+
+static qboolean CoF_ReadInt( const cof_player_t *p, int ofs, int *out )
+{
+	if( ofs < 0 || (size_t)ofs + sizeof( int ) > p->size )
+		return false;
+
+	memcpy( out, p->pv + ofs, sizeof( int ));
+	return true;
+}
+
+static void CoF_WriteInt( const cof_player_t *p, int ofs, int value )
+{
+	if( ofs < 0 || (size_t)ofs + sizeof( int ) > p->size )
+		return;
+
+	memcpy( p->pv + ofs, &value, sizeof( int ));
+}
+
+/*
+=============================================================================
+
+gate
+
+=============================================================================
+*/
+typedef enum
+{
+	COF_GATE_OK = 0,
+	COF_GATE_NOT_IN_GAME,   // no running, non-background game or no spawned player
+	COF_GATE_NO_CHEATS,     // sv_cheats 0
+	COF_GATE_WRONG_DLL,     // not the retail hl.dll, or an unsupported engine build
+} cof_gate_t;
+
+static cof_gate_t CoF_Gate( const sv_client_t *cl )
+{
+	if( sv.state != ss_active || sv.background || cl->state != cs_spawned )
+		return COF_GATE_NOT_IN_GAME;
+
+	if( !Cvar_VariableInteger( "sv_cheats" ))
+		return COF_GATE_NO_CHEATS;
+
+	if( CoF_GameDllState() != COF_HASH_MATCH )
+		return COF_GATE_WRONG_DLL;
+
+	return COF_GATE_OK;
+}
+
+// the one-line refusal every cof_* command prints when it cannot run
+static qboolean CoF_Refuse( sv_client_t *cl, const char *name, cof_gate_t gate )
+{
+	switch( gate )
+	{
+	case COF_GATE_NOT_IN_GAME:
+		SV_ClientPrintf( cl, "%s: needs a loaded game (not the menu background)\n", name );
+		break;
+	case COF_GATE_NO_CHEATS:
+		SV_ClientPrintf( cl, "%s: needs sv_cheats 1\n", name );
+		break;
+	case COF_GATE_WRONG_DLL:
+		SV_ClientPrintf( cl, "%s: refused: %s\n", name, CoF_HashRefusal( CoF_GameDllState( )));
+		break;
+	default:
+		break;
+	}
+	return true;
+}
+
+static qboolean CoF_PlayerOrRefuse( sv_client_t *cl, const char *name, cof_player_t *p )
+{
+	if( CoF_GetPlayer( cl, p ))
+		return true;
+
+	SV_ClientPrintf( cl, "%s: refused: the player object does not look like the retail Cry of Fear player\n", name );
+	return false;
+}
+
+// "0" or "1" in argv[1]; no argument toggles when toggle_ok, else is an error
+static qboolean CoF_ParseSwitch( int *out, qboolean current, qboolean toggle_ok )
+{
+	const char *arg;
+
+	if( Cmd_Argc() < 2 )
+	{
+		if( !toggle_ok )
+			return false;
+		*out = !current;
+		return true;
+	}
+
+	arg = Cmd_Argv( 1 );
+	if(( arg[0] == '0' || arg[0] == '1' ) && arg[1] == '\0' )
+	{
+		*out = arg[0] - '0';
+		return true;
+	}
+
+	return false;
+}
+
+static cof_latch_t *CoF_Latch( const sv_client_t *cl )
+{
+	int slot = CoF_ClientSlot( cl );
+
+	return slot >= 0 ? &cof_latches[slot] : NULL;
+}
+
+static qboolean CoF_AnyLatched( const cof_latch_t *l )
+{
+	return l->noclip || l->notarget || l->fly || l->infammo || l->infstamina || l->nodamage || l->nodrown;
+}
+
+/*
+=============================================================================
+
+bucket A: noclip, notarget, fly (latched), give
+
+=============================================================================
+*/
+static qboolean CoF_Alive( const edict_t *ent )
+{
+	return ent->v.deadflag == DEAD_NO && ent->v.health > 0.0f;
+}
+
+static qboolean CoF_Cmd_Movetype( sv_client_t *cl, const char *name, qboolean *latch, qboolean *other, int movetype )
+{
+	edict_t *ent = cl->edict;
+	int on;
+
+	if( !CoF_ParseSwitch( &on, *latch, true ))
+	{
+		SV_ClientPrintf( cl, "usage: %s [0|1]\n", name );
+		return true;
+	}
+
+	*latch = on;
+	if( on )
+	{
+		*other = false; // noclip and fly exclude each other
+		if( CoF_Alive( ent ))
+			ent->v.movetype = movetype;
+	}
+	else if( ent->v.movetype == movetype )
+	{
+		ent->v.movetype = MOVETYPE_WALK;
+	}
+
+	SV_ClientPrintf( cl, "%s %s\n", name, on ? "ON" : "OFF" );
+	return true;
+}
+
+static qboolean CoF_Cmd_Notarget( sv_client_t *cl, cof_latch_t *l )
+{
+	edict_t *ent = cl->edict;
+	int on;
+
+	if( !CoF_ParseSwitch( &on, l->notarget, true ))
+	{
+		SV_ClientPrintf( cl, "usage: notarget [0|1]\n" );
+		return true;
+	}
+
+	l->notarget = on;
+	if( on ) SetBits( ent->v.flags, FL_NOTARGET );
+	else ClearBits( ent->v.flags, FL_NOTARGET );
+
+	SV_ClientPrintf( cl, "notarget %s\n", on ? "ON" : "OFF" );
+	return true;
+}
+
+// has the game taken the item? AttachToPlayer (weapons) hides it on the player,
+// the ammo and item pickups clear its touch and use functions and schedule
+// SUB_Remove, UTIL_Remove marks it FL_KILLME
+static qboolean CoF_ItemTaken( const edict_t *ent, const edict_t *player, const byte *pv, size_t pvsize, const int before[2] )
+{
+	int after[2];
+
+	if( ent->free || FBitSet( ent->v.flags, FL_KILLME ) || ent->v.owner == player || ent->v.aiment == player || FBitSet( ent->v.effects, EF_NODRAW ))
+		return true;
+
+	if( !pv || pvsize < COF_PV_USE + sizeof( int ) || !before )
+		return false;
+
+	memcpy( &after[0], pv + COF_PV_TOUCH, sizeof( int ));
+	memcpy( &after[1], pv + COF_PV_USE, sizeof( int ));
+	return ( before[0] || before[1] ) && !after[0] && !after[1];
+}
+
+// CBasePlayer::GiveNamedItem, done by the engine: the same creation ent_create
+// uses, placed on the player and spawned; then the player "uses" it the way a
+// Cry of Fear pickup is taken (+use held, CBasePlayerItem/Ammo::DefaultUse and
+// CItem::ItemUse), with a plain touch as the fallback for anything else
+static qboolean CoF_Cmd_Give( sv_client_t *cl )
+{
+	static const char *prefixes[] = { "weapon_", "item_", "ammo_" };
+	const char *classname = Cmd_Argv( 1 );
+	qboolean prefix_ok = false, taken;
+	edict_t *player = cl->edict;
+	int before[2] = { 0, 0 };
+	size_t pvsize = 0;
+	edict_t *ent;
+	byte *pv;
+	int i, buttons;
+
+	if( Cmd_Argc() != 2 || !classname[0] )
+	{
+		SV_ClientPrintf( cl, "usage: give <classname>, e.g. give weapon_glock\n" );
+		return true;
+	}
+
+	// anything else (a monster, a trigger, a second player) can take the game
+	// DLL down; ent_create with sv_enttools_enable 1 is still there for that
+	for( i = 0; i < ARRAYSIZE( prefixes ); i++ )
+	{
+		if( !Q_strnicmp( classname, prefixes[i], Q_strlen( prefixes[i] )))
+			prefix_ok = true;
+	}
+
+	if( !prefix_ok )
+	{
+		SV_ClientPrintf( cl, "give: only weapon_*, item_* and ammo_* classnames (use ent_create for anything else)\n" );
+		return true;
+	}
+
+	if( !CoF_Alive( player ))
+	{
+		SV_ClientPrintf( cl, "give: you are dead\n" );
+		return true;
+	}
+
+	ent = SV_CreateNamedEntity( NULL, SV_AllocString( classname ));
+	if( !SV_IsValidEdict( ent ) || !ent->pvPrivateData )
+	{
+		if( SV_IsValidEdict( ent ))
+			SV_FreeEdict( ent );
+		SV_ClientPrintf( cl, "give: no such entity \"%s\"\n", classname );
+		return true;
+	}
+
+	VectorCopy( player->v.origin, ent->v.origin );
+	SetBits( ent->v.spawnflags, BIT( 30 )); // SF_NORESPAWN, as GiveNamedItem does
+
+	if( svgame.dllFuncs.pfnSpawn( ent ) == -1 || ent->free || FBitSet( ent->v.flags, FL_KILLME ))
+	{
+		if( !ent->free )
+			SV_FreeEdict( ent );
+		SV_ClientPrintf( cl, "give: \"%s\" removed itself on spawn\n", classname );
+		return true;
+	}
+
+	pv = CoF_EntityPrivate( ent, -1, COF_PV_USE + sizeof( int ), &pvsize );
+	if( pv )
+	{
+		memcpy( &before[0], pv + COF_PV_TOUCH, sizeof( int ));
+		memcpy( &before[1], pv + COF_PV_USE, sizeof( int ));
+	}
+
+	buttons = player->v.button;
+	SetBits( player->v.button, IN_USE );
+	svgame.dllFuncs.pfnUse( ent, player );
+	taken = CoF_ItemTaken( ent, player, pv, pvsize, pv ? before : NULL );
+
+	if( !taken && !ent->free )
+	{
+		svgame.dllFuncs.pfnTouch( ent, player );
+		taken = CoF_ItemTaken( ent, player, pv, pvsize, pv ? before : NULL );
+	}
+	player->v.button = buttons;
+
+	if( taken )
+		SV_ClientPrintf( cl, "give: %s\n", classname );
+	else
+		SV_ClientPrintf( cl, "give: %s was not taken (already carried, inventory full or not allowed), it is at your feet\n", classname );
+
+	return true;
+}
