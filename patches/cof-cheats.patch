+/*
+=============================================================================
+
+dispatch
+
+=============================================================================
+*/
+qboolean SV_CoF_CheatsClientCommand( sv_client_t *cl )
+{
+	const char *cmd = Cmd_Argv( 0 );
+	cof_latch_t *l = CoF_Latch( cl );
+	qboolean stock_name;
+	cof_gate_t gate;
+
+	if( !l || !cmd[0] )
+		return false;
+
+	stock_name = !Q_strcmp( cmd, "noclip" ) || !Q_strcmp( cmd, "notarget" ) || !Q_strcmp( cmd, "give" );
+
+	if( !stock_name && Q_strcmp( cmd, "fly" ) && Q_strncmp( cmd, "cof_", 4 ))
+		return false;
+
+	if( !Q_strcmp( cmd, "cof_cheats" ))
+		return CoF_Cmd_Status( cl );
+
+	gate = CoF_Gate( cl );
+
+	if( stock_name )
+	{
+		// retail hl.dll not loaded (or no cheats): the engine's own noclip and
+		// notarget, and the game DLL's own "give", exactly as before
+		if( gate != COF_GATE_OK )
+		{
+			if( gate == COF_GATE_NO_CHEATS && !Q_strcmp( cmd, "give" ) && CoF_GameDllState() == COF_HASH_MATCH )
+			{
+				SV_ClientPrintf( cl, "give: needs sv_cheats 1\n" );
+				return true;
+			}
+			return false;
+		}
+
+		if( !Q_strcmp( cmd, "noclip" ))
+			return CoF_Cmd_Movetype( cl, "noclip", &l->noclip, &l->fly, MOVETYPE_NOCLIP );
+		if( !Q_strcmp( cmd, "notarget" ))
+			return CoF_Cmd_Notarget( cl, l );
+		return CoF_Cmd_Give( cl );
+	}
+
+	if( Q_strcmp( cmd, "fly" ) && Q_strcmp( cmd, "cof_infammo" ) && Q_strcmp( cmd, "cof_infstamina" ) &&
+		Q_strcmp( cmd, "cof_ending" ) && Q_strcmp( cmd, "cof_nodamage" ) && Q_strcmp( cmd, "cof_nodrown" ) &&
+		Q_strcmp( cmd, "cof_nightvision" ) && Q_strcmp( cmd, "cof_unlockdoors" ) && Q_strcmp( cmd, "cof_tapes" ))
+		return false; // some other cof_ name: not ours, the game DLL may know it
+
+	if( gate != COF_GATE_OK )
+		return CoF_Refuse( cl, cmd, gate );
+
+	if( !Q_strcmp( cmd, "fly" ))
+		return CoF_Cmd_Movetype( cl, "fly", &l->fly, &l->noclip, MOVETYPE_FLY );
+	if( !Q_strcmp( cmd, "cof_infammo" ))
+		return CoF_Cmd_BoolLatch( cl, cmd, &l->infammo, COF_PL_INFINITE_AMMO, "infinite ammo, no reload, infinite syringes and flares" );
+	if( !Q_strcmp( cmd, "cof_infstamina" ))
+		return CoF_Cmd_BoolLatch( cl, cmd, &l->infstamina, COF_PL_INFINITE_STAMINA, "infinite sprint, dodge and jump stamina" );
+	if( !Q_strcmp( cmd, "cof_nodamage" ))
+	{
+		// in multiplayer the retail PostThink hides a player whose door flag is
+		// set (EF_NODRAW, 100EBDB0), which would leave you invisible
+		if( svs.maxclients > 1 )
+		{
+			SV_ClientPrintf( cl, "cof_nodamage: single player only (in coop the game hides a player with this flag)\n" );
+			return true;
+		}
+		return CoF_Cmd_BoolLatch( cl, cmd, &l->nodamage, COF_PL_GOING_THROUGH_DOOR, "take no damage" );
+	}
+	if( !Q_strcmp( cmd, "cof_nodrown" ))
+		return CoF_Cmd_Nodrown( cl, l );
+	if( !Q_strcmp( cmd, "cof_ending" ))
+		return CoF_Cmd_Ending( cl );
+	if( !Q_strcmp( cmd, "cof_nightvision" ))
+		return CoF_Cmd_Nightvision( cl );
+	if( !Q_strcmp( cmd, "cof_unlockdoors" ))
+		return CoF_Cmd_UnlockDoors( cl );
+	return CoF_Cmd_Tapes( cl );
+}
+
+/*
+=============================================================================
+
+per frame
+
+=============================================================================
+*/
+// sv_cheats went to 0: put back what the latches hold and forget them
+static void CoF_ReleaseLatches( sv_client_t *cl, cof_latch_t *l )
+{
+	cof_player_t p;
+
+	if( CoF_GameDllState() == COF_HASH_MATCH && CoF_GetPlayer( cl, &p ))
+	{
+		if(( l->noclip && p.ent->v.movetype == MOVETYPE_NOCLIP ) || ( l->fly && p.ent->v.movetype == MOVETYPE_FLY ))
+			p.ent->v.movetype = MOVETYPE_WALK;
+		if( l->notarget )
+			ClearBits( p.ent->v.flags, FL_NOTARGET );
+		if( l->infammo )
+			CoF_WriteBool( &p, COF_PL_INFINITE_AMMO, false );
+		if( l->infstamina )
+			CoF_WriteBool( &p, COF_PL_INFINITE_STAMINA, false );
+		if( l->nodamage )
+			CoF_WriteBool( &p, COF_PL_GOING_THROUGH_DOOR, false );
+	}
+
+	memset( l, 0, sizeof( *l ));
+	SV_ClientPrintf( cl, "cof cheats: sv_cheats is 0, latched cheats switched off\n" );
+}
+
+static void CoF_KeepBool( sv_client_t *cl, const cof_player_t *p, qboolean *latch, int ofs, const char *name )
+{
+	if( !*latch )
+		return;
+
+	if( !CoF_WriteBool( p, ofs, true ))
+	{
+		*latch = false;
+		SV_ClientPrintf( cl, "%s: switched off, unexpected value %d in the player field\n", name, p->pv[ofs] );
+	}
+}
+
+void SV_CoF_CheatsPostThink( sv_client_t *cl )
+{
+	cof_latch_t *l = CoF_Latch( cl );
+	cof_player_t p;
+	edict_t *ent;
+
+	if( !l || !CoF_AnyLatched( l ))
+		return;
+
+	// the menu background map and a level still loading are simply skipped:
+	// the latches wait for the next real game frame
+	if( sv.state != ss_active || sv.background || cl->state != cs_spawned )
+		return;
+
+	if( !Cvar_VariableInteger( "sv_cheats" ))
+	{
+		CoF_ReleaseLatches( cl, l );
+		return;
+	}
+
+	if( CoF_GameDllState() != COF_HASH_MATCH || !CoF_GetPlayer( cl, &p ))
+		return;
+
+	ent = p.ent;
+
+	// retail PostThink turns MOVETYPE_NOCLIP back into MOVETYPE_WALK; anything
+	// else the game chose (ladder, cutscene freeze, death) is left alone and
+	// the latch takes over again once the game hands back MOVETYPE_WALK
+	if( CoF_Alive( ent ) && ent->v.movetype == MOVETYPE_WALK )
+	{
+		if( l->noclip )
+			ent->v.movetype = MOVETYPE_NOCLIP;
+		else if( l->fly )
+			ent->v.movetype = MOVETYPE_FLY;
+	}
+
+	if( l->notarget && CoF_Alive( ent ))
+		SetBits( ent->v.flags, FL_NOTARGET );
+
+	if( l->nodrown )
+		ent->v.air_finished = svgame.globals->time + 12.0f;
+
+	CoF_KeepBool( cl, &p, &l->infammo, COF_PL_INFINITE_AMMO, "cof_infammo" );
+	CoF_KeepBool( cl, &p, &l->infstamina, COF_PL_INFINITE_STAMINA, "cof_infstamina" );
+	if( svs.maxclients == 1 )
+		CoF_KeepBool( cl, &p, &l->nodamage, COF_PL_GOING_THROUGH_DOOR, "cof_nodamage" );
+	else l->nodamage = false;
+}
