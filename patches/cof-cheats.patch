+static qboolean CoF_Cmd_Status( sv_client_t *cl )
+{
+	cof_hash_state_t hs = CoF_GameDllState();
+	cof_latch_t *l = CoF_Latch( cl );
+	cof_player_t p;
+
+	if( hs == COF_HASH_MATCH )
+		SV_ClientPrintf( cl, "cof cheats: sv_cheats %d, hl.dll is the retail 1.6 build\n", Cvar_VariableInteger( "sv_cheats" ));
+	else SV_ClientPrintf( cl, "cof cheats: sv_cheats %d, OFF: %s\n", Cvar_VariableInteger( "sv_cheats" ), CoF_HashRefusal( hs ));
+
+	if( cof_hash.hex[0] )
+		SV_ClientPrintf( cl, "hl.dll sha256 %s\n", cof_hash.hex );
+
+	if( !l )
+		return true;
+
+	SV_ClientPrintf( cl, "latched: noclip %d notarget %d fly %d infammo %d infstamina %d nodamage %d nodrown %d\n",
+		l->noclip, l->notarget, l->fly, l->infammo, l->infstamina, l->nodamage, l->nodrown );
+
+	if( hs != COF_HASH_MATCH || !CoF_GetPlayer( cl, &p ))
+		return true;
+
+	{
+		byte ammo = 0, stam = 0, door = 0, nv = 0, r = 0, g = 0, d = 0;
+		int shield = 0, tapes = 0;
+		float stamina = 0.0f;
+
+		CoF_ReadBool( &p, COF_PL_INFINITE_AMMO, &ammo );
+		CoF_ReadBool( &p, COF_PL_INFINITE_STAMINA, &stam );
+		CoF_ReadBool( &p, COF_PL_GOING_THROUGH_DOOR, &door );
+		CoF_ReadBool( &p, COF_PL_HAS_NIGHTVISION, &nv );
+		CoF_ReadBool( &p, COF_PL_ENDING_ROOFBOSS, &r );
+		CoF_ReadBool( &p, COF_PL_ENDING_GIVENP345, &g );
+		CoF_ReadBool( &p, COF_PL_ENDING_DELIVERED, &d );
+		CoF_ReadInt( &p, COF_PL_HEADSHIELD, &shield );
+		CoF_ReadInt( &p, COF_PL_TAPES, &tapes );
+		memcpy( &stamina, p.pv + COF_PL_STAMINA, sizeof( stamina ));
+
+		SV_ClientPrintf( cl, "player: movetype %d flags 0x%x health %g origin %.0f %.0f %.0f air %.1f\n",
+			p.ent->v.movetype, p.ent->v.flags, p.ent->v.health,
+			p.ent->v.origin[0], p.ent->v.origin[1], p.ent->v.origin[2],
+			p.ent->v.air_finished - sv.time );
+		SV_ClientPrintf( cl, "player: infammo %d infstamina %d stamina %.1f door %d nightvision %d/%d tapes %d ending %d%d%d\n",
+			ammo, stam, stamina, door, nv, shield, tapes, r, g, d );
+	}
+
+	return true;
+}
