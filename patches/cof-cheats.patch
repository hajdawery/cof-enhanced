+/*
+=============================================================================
+
+bucket B: writes into the retail player object
+
+=============================================================================
+*/
+static qboolean CoF_Cmd_BoolLatch( sv_client_t *cl, const char *name, qboolean *latch, int ofs, const char *what )
+{
+	cof_player_t p;
+	byte cur;
+	int on;
+
+	if( !CoF_PlayerOrRefuse( cl, name, &p ))
+		return true;
+
+	if( !CoF_ReadBool( &p, ofs, &cur ))
+	{
+		SV_ClientPrintf( cl, "%s: refused: unexpected value %d in the player field\n", name, p.pv[ofs] );
+		*latch = false;
+		return true;
+	}
+
+	if( !CoF_ParseSwitch( &on, *latch, false ))
+	{
+		SV_ClientPrintf( cl, "%s is %d (game field %d): usage %s 0|1 (%s)\n", name, *latch, cur, name, what );
+		return true;
+	}
+
+	*latch = on;
+	CoF_WriteBool( &p, ofs, on );
+	SV_ClientPrintf( cl, "%s %s\n", name, on ? "ON" : "OFF" );
+	return true;
+}
+
+static qboolean CoF_Cmd_Nodrown( sv_client_t *cl, cof_latch_t *l )
+{
+	cof_player_t p;
+	int on;
+
+	if( !CoF_PlayerOrRefuse( cl, "cof_nodrown", &p ))
+		return true;
+
+	if( !CoF_ParseSwitch( &on, l->nodrown, false ))
+	{
+		SV_ClientPrintf( cl, "cof_nodrown is %d: usage cof_nodrown 0|1 (never run out of air)\n", l->nodrown );
+		return true;
+	}
+
+	l->nodrown = on;
+	if( on )
+		p.ent->v.air_finished = sv.time + 12.0f;
+	SV_ClientPrintf( cl, "cof_nodrown %s\n", on ? "ON" : "OFF" );
+	return true;
+}
