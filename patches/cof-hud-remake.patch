+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 haej (Cry of Fear: Enhanced contributors)
+// Optional presentation only: never changes client messages or weapon state.
+#include "common.h"
+#include "client.h"
+
+static CVAR_DEFINE_AUTO( cof_hud_style, "0", FCVAR_ARCHIVE, "Cry of Fear HUD: 0 Classic, 1 Remake (health, stamina and supported ammunition)" );
+
+enum { HUD_HEALTH = 1, HUD_STAMINA = 2, HUD_MAX_DRAWS = 64 };
+typedef struct
+{
+	int texture, mode, digit, kind;
+	float x, y, w, h, s1, t1, s2, t2;
+	byte color[4];
+} cof_hud_draw_t;
+typedef struct { int texture; float u1,v1,u2,v2,aspect; const char *path; } cof_hud_icon_t;
+static cof_hud_icon_t hud_icons[] = {
+	{ 0,0,0,0,0,1,"gfx/shell/hud_remake/heart.png" },
+	{ 0,0,0,0,0,1,"gfx/shell/hud_remake/bullet.png" },
+	{ 0,0,0,0,0,1,"gfx/shell/hud_remake/magazine.png" },
+	{ 0,0,0,0,0,1,"gfx/shell/hud_remake/shell.png" },
+};
+static struct
+{
+	int weapon, clip, stamina, health_cap, previous_health;
+	qboolean dual, collecting, overflow;
+	int count, health_frame, stamina_frame;
+	byte health_alpha, stamina_alpha;
+	double damage_until, retry_icons;
+	cof_hud_draw_t draws[HUD_MAX_DRAWS];
+} hud;
+
+void CL_CoF_HudRemakeReset( void )
+{
+	memset( &hud, 0, sizeof( hud ));
+	hud.clip = hud.stamina = hud.previous_health = -1;
+	hud.health_frame = hud.stamina_frame = -1;
+	hud.health_cap = 100;
+}
+
+void CL_CoF_HudRemakeInit( void )
+{
+	Cvar_RegisterVariable( &cof_hud_style );
+	CL_CoF_HudRemakeReset();
+}
+
+// Packet formats measured in retail client.dll. Observe, never consume.
+void CL_CoF_HudRemakeMessage( const char *name, int size, const byte *data )
+{
+	if( !Q_stricmp( name, "ResetHUD" ) || !Q_stricmp( name, "InitHUD" ))
+		CL_CoF_HudRemakeReset();
+	else if( !Q_stricmp( name, "Stamina" ) && size == 3 )
+		hud.stamina = bound( 0, data[0], 100 ); // second field is a recovery delay, not stamina
+	else if( !Q_stricmp( name, "HealthCap" ) && size == 1 && data[0] > 0 )
+		hud.health_cap = data[0];
+	else if( !Q_stricmp( name, "CurWeapon" ) && size == 3 )
+	{
+		const int weapon = (signed char)data[1];
+		int clip = (signed char)data[2];
+		if( weapon < 1 ) { hud.weapon = 0; hud.clip = -1; }
+		else if( data[0] )
+		{
+			if( clip < -1 ) clip = -clip; // matches the client's clip convention
+			hud.weapon = weapon; hud.clip = clip;
+		}
+	}
+	else if( !Q_stricmp( name, "DualAmmo" ) && size == 8 )
+	{
+		int left, right;
+		memcpy( &left, data, 4 ); memcpy( &right, data + 4, 4 );
+		hud.dual = left >= 0 && right >= 0;
+	}
+}
+
+static qboolean HudEnabled( void )
+{
+	return cof_hud_style.value == 1 && GI && !Q_stricmp( GI->gamefolder, "cryoffear" ) &&
+		cls.state == ca_active && !cl.background && !cl.intermission && cl.local.health > 0 && !CL_CoF_UIGateActive();
+}
+
+static qboolean HudIcons( void )
+{
+	if( host.realtime < hud.retry_icons ) return false;
+	for( int i = 0; i < ARRAYSIZE( hud_icons ); i++ )
+	{
+		cof_hud_icon_t *icon = &hud_icons[i];
+		if( icon->texture && ref.dllFuncs.GL_FindTexture( icon->path ) == icon->texture ) continue;
+		icon->texture = 0;
+		rgbdata_t *pic = FS_LoadImage( icon->path, NULL, 0 );
+		if( !pic || pic->type != PF_RGBA_32 || pic->width <= 0 || pic->height <= 0 )
+		{
+			if( pic ) FS_FreeImage( pic );
+			hud.retry_icons = host.realtime + 5;
+			return false; // missing art never hides the Classic HUD
+		}
+		int l = pic->width, t = pic->height, r = -1, b = -1;
+		for( int y = 0; y < pic->height; y++ ) for( int x = 0; x < pic->width; x++ )
+			if( pic->buffer[( y * pic->width + x ) * 4 + 3] >= 128 )
+			{ l = Q_min(l,x); r = Q_max(r,x); t = Q_min(t,y); b = Q_max(b,y); }
+		if( r < l || b < t ) { FS_FreeImage(pic); hud.retry_icons = host.realtime + 5; return false; }
+		icon->u1 = (float)l / pic->width; icon->v1 = (float)t / pic->height;
+		icon->u2 = (float)(r+1) / pic->width; icon->v2 = (float)(b+1) / pic->height;
+		icon->aspect = (float)(r-l+1) / (b-t+1);
+		// No pixels are reused after upload; TF_IMAGE disables mipmap generation.
+		icon->texture = GL_LoadTextureInternal( icon->path, pic, TF_IMAGE );
+		FS_FreeImage( pic );
+		if( !icon->texture ) { hud.retry_icons = host.realtime + 5; return false; }
+	}
+	return true;
+}
+
+static float HudScale( void )
+{
+	// Compact reference dimensions at 1080p; retain the player's HUD multiplier.
+	return bound( 0.5f, refState.height / 1080.0f * CL_CoF_UIScaleUser(), 4.0f );
+}
+
+static void HudIcon( int index, float x, float y, float size, const byte *color )
+{
+	cof_hud_icon_t *icon = &hud_icons[index];
+	float w = size, h = size;
+	if( icon->aspect > 1 ) h /= icon->aspect; else w *= icon->aspect;
+	ref.dllFuncs.GL_SetRenderMode( kRenderTransTexture );
+	ref.dllFuncs.Color4ub(color[0],color[1],color[2],color[3]);
+	ref.dllFuncs.R_DrawStretchPic(x+(size-w)*0.5f,y+(size-h)*0.5f,w,h,icon->u1,icon->v1,icon->u2,icon->v2,icon->texture);
+}
+
+static void HudReplay( void )
+{
+	for( int i = 0; i < hud.count; i++ )
+	{
+		cof_hud_draw_t *d = &hud.draws[i];
+		ref.dllFuncs.GL_SetRenderMode(d->mode);
+		ref.dllFuncs.Color4ub(d->color[0],d->color[1],d->color[2],d->color[3]);
+		ref.dllFuncs.R_DrawStretchPic(d->x,d->y,d->w,d->h,d->s1,d->t1,d->s2,d->t2,d->texture);
+	}
+	hud.count = 0;
+}
+
+void CL_CoF_HudRemakeBegin( void )
+{
+	hud.count = 0; hud.overflow = false;
+	hud.collecting = HudEnabled() && HudIcons() && cls.creditsFont.valid;
+	if( hud.previous_health >= 0 && cl.local.health < hud.previous_health ) hud.damage_until = host.realtime + 0.4;
+	hud.previous_health = cl.local.health;
+}
+
+// Same-frame calls only; exact final geometry/mode/color retained for fallback.
+qboolean CL_CoF_HudRemakeSprite( const char *name, const wrect_t *rc, int mode, int texture,
+	float x,float y,float w,float h,float s1,float t1,float s2,float t2,const byte *color )
+{
+	if( !hud.collecting || hud.overflow ) return false;
+	if( !name || hud.clip < 0 || hud.dual || x < refState.width * 0.5f || y < refState.height * 0.5f )
+	{ if(hud.count) { HudReplay(); hud.overflow=true; ref.dllFuncs.GL_SetRenderMode(mode); } return false; }
+	int kind = 0, digit = -1;
+	static const char *guns[] = { "glock", "p345", "m16", "tmp", "rifle", "browning", "famas", "vp70", "g43", "mp5" };
+	for( int i = 0; i < ARRAYSIZE(guns); i++ )
+	{
+		char sprite[96];
+		Q_snprintf(sprite,sizeof(sprite),"sprites/cof_%s_mag.spr",guns[i]);
+		if( !Q_stricmp(name,sprite) ) kind = 1;
+		Q_snprintf(sprite,sizeof(sprite),"sprites/cof_%s_mag_icon.spr",guns[i]);
+		if( !Q_stricmp(name,sprite) ) kind = 2;
+	}
+	if( !Q_stricmp(name,"sprites/cof_mag_cross.spr") ) kind = 3;
+	if( !Q_stricmp(name,"sprites/cof_ammohud.spr") && rc && rc->top == 0 &&
+		rc->bottom == 24 && rc->right - rc->left == 20 && rc->left >= 0 && rc->left <= 216 && rc->left % 24 == 0 )
+	{ kind = 4; digit = rc->left / 24; }
+	if( hud.weapon == 23 && !Q_stricmp(name,"sprites/cof_famas_mag.spr") ) kind = 8;
+	if( hud.weapon == 19 && !Q_stricmp(name,"sprites/cof_vp70_mag.spr") ) kind = 7;
+	if( hud.weapon == 4 && !Q_stricmp(name,"sprites/cof_shotgun_box.spr") ) kind = 5;
+	if( hud.weapon == 4 && !Q_stricmp(name,"sprites/cof_shotgun_box_icon.spr") ) kind = 6;
+	if( !kind ) { if(hud.count) { HudReplay(); hud.overflow=true; ref.dllFuncs.GL_SetRenderMode(mode); } return false; }
+	if( hud.count == HUD_MAX_DRAWS ) { HudReplay(); hud.overflow = true; ref.dllFuncs.GL_SetRenderMode(mode); return false; }
+	cof_hud_draw_t *d = &hud.draws[hud.count++];
+	*d = (cof_hud_draw_t){texture,mode,digit,kind,x,y,w,h,s1,t1,s2,t2,{0}};
+	memcpy(d->color,color,4);
+	return true;
+}
+
+static int HudMagazineCount( void )
+{
+	int order[4], n = 0; qboolean magazine = false, cross = false, shells = false, shell_icon = false;
+	for( int i=0; i<hud.count; i++ )
+	{
+		cof_hud_draw_t *d=&hud.draws[i];
+		if(d->kind==1 || d->kind==7 || d->kind==8) magazine=true;
+		if(d->kind==3) cross=true;
+		if(d->kind==5) shells=true;
+		if(d->kind==6) shell_icon=true;
+		if(d->kind!=4) continue;
+		if(n==4) return -1;
+		order[n++]=i;
+	}
+	if((hud.weapon==4 ? (!shells || !shell_icon) : (!magazine || !cross)) || n<1 || n>3) return -1;
+	for(int i=1;i<n;i++) for(int j=i;j>0 && hud.draws[order[j]].x<hud.draws[order[j-1]].x;j--)
+	{ int temp=order[j];order[j]=order[j-1];order[j-1]=temp; }
+	int count=0;
+	for(int i=0;i<n;i++)
+	{
+		cof_hud_draw_t *d=&hud.draws[order[i]];
+		if(i && (fabs(d->y-hud.draws[order[0]].y)>1.0f ||
+			d->x-hud.draws[order[i-1]].x < d->w*0.5f || d->x-hud.draws[order[i-1]].x > d->w*1.6f)) return -1;
+		count=count*10+d->digit;
+	}
+	return count;
+}
+
+void CL_CoF_HudRemakeAmmo( void )
+{
+	hud.collecting = false;
+	const int mags=HudMagazineCount();
+	if(mags<0 || !HudEnabled() || !cls.creditsFont.valid) { HudReplay(); return; }
+	float scale=HudScale(), size=24*scale, gap=6*scale, margin=28*scale;
+	cl_font_t font=cls.creditsFont;
+	float ratio=24*scale/Q_max(1,font.charHeight);
+	font.scale*=ratio; font.charHeight=Q_max(1,(int)(font.charHeight*ratio));
+	for(int i=0;i<ARRAYSIZE(font.charWidths);i++) font.charWidths[i]=Q_max(1,(int)(font.charWidths[i]*ratio));
+	char rounds[16], spare[16]; int rw,mw;
+	Q_snprintf(rounds,sizeof(rounds),"%d",hud.clip); Q_snprintf(spare,sizeof(spare),"%d",mags);
+	CL_DrawStringLen(&font,rounds,&rw,NULL,0); CL_DrawStringLen(&font,spare,&mw,NULL,0);
+	byte color[4]={245,245,245,255};
+	// Reuse the Classic draw's visibility/fade rather than introducing an always-on counter.
+	for(int i=0;i<hud.count;i++) if(hud.draws[i].kind==4) { color[3]=hud.draws[i].color[3]; break; }
+	float total=size*2+gap*3+rw+mw+12*scale;
+	float x=refState.width-margin-total, y=refState.height-margin-size;
+	HudIcon(hud.weapon==4?3:1,x,y,size,color); x+=size+gap;
+	CL_DrawString(x,y,rounds,color,&font,0); x+=rw+12*scale+gap;
+	HudIcon(hud.weapon==4?3:2,x,y,size,color); x+=size+gap;
+	CL_DrawString(x,y,spare,color,&font,0);
+	// Proven retail fixed modes; no speculative switchable-mode state.
+	for(int i=0;i<hud.count;i++) if(hud.draws[i].kind==7 || hud.draws[i].kind==8)
+	{ const char *mode=hud.draws[i].kind==7?"BURST":"AUTO"; int width; CL_DrawStringLen(&font,mode,&width,NULL,0); CL_DrawString(refState.width-margin-width,y-size-gap,mode,color,&font,0); break; }
+	hud.count=0;
+	ref.dllFuncs.GL_SetRenderMode(kRenderNormal); ref.dllFuncs.Color4ub(255,255,255,255);
+}
+
