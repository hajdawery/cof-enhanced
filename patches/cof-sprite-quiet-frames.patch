+/*
+==============================================================================
+
+	CRY OF FEAR: OUT-OF-RANGE SPRITE FRAMES  (cof_sprite_quiet_frames, cof_sprite_trace)
+
+The flood "R_GetSpriteFrame: no such frame 255 (sprites/glow01.spr)" is
+engine/client/cl_sprite.c's R_GetSpriteFrame, which logs with a plain
+Con_Printf on every call. Its caller is R_DrawSpriteModel below: a one-frame
+sprite never takes the lerp path (R_SpriteAllowLerping), so every frame of
+every visible glow asks the engine for frame curstate.frame.
+
+Where 255 comes from (hl.dll, measured by disassembly, see
+docs/cof-sprite-quiet-frames.md): CSprite::Animate (hl.dll 10092590) adds
+framerate * dt to pev->frame and wraps it with fmod( frame, m_maxFrame ) only
+when m_maxFrame > 0. For a one-frame sprite m_maxFrame is 0, so an animated
+glow's pev->frame climbs without bound for as long as it lives, and the 8-bit
+network field saturates at 255. glow01.spr is exactly that: one frame, used by
+the map's env_sprite lamp halos with a framerate, and by CTapeRecorder's blink
+(hl.dll 1007C440, framerate 10). Stock GoldSrc clamps the same way and says
+nothing; the frame shown is the only frame the sprite has either way.
+
+cof_sprite_quiet_frames 1 (default) clamps here, before the engine sees the
+value, so the draw is unchanged and the engine's per-call warning never fires;
+one line per sprite model is still printed at developer level.
+cof_sprite_trace 1 prints the attribution for each sprite model once: name,
+requested frame, numframes, entity index, render state and the calling path.
+cof_sprite_quiet_frames 0 is stock behaviour.
+
+==============================================================================
+*/
+CVAR_DEFINE_AUTO( cof_sprite_quiet_frames, "1", FCVAR_GLCONFIG, "Cry of Fear: clamp an out-of-range sprite frame (the game's one-frame glow sprites are animated past their only frame, up to 255) silently instead of logging it on every draw; one developer-level line per sprite. 0 = stock behaviour" );
+CVAR_DEFINE_AUTO( cof_sprite_trace, "0", 0, "developer: print sprite name, requested frame, numframes, entity index, render state and calling path once per sprite model that asks for an out-of-range frame" );
+
+#define COF_SPRITE_SEEN_MAX	64
+
+typedef struct
+{
+	const model_t	*models[COF_SPRITE_SEEN_MAX];
+	int		count;
+} cof_sprite_seen_t;
+
+static cof_sprite_seen_t	cof_sprite_trace_seen;
+static cof_sprite_seen_t	cof_sprite_warn_seen;
+
+// true when this model was already reported; otherwise remembers it
+static qboolean R_CoFSpriteSeen( cof_sprite_seen_t *table, const model_t *model )
+{
+	int	i;
+
+	for( i = 0; i < table->count; i++ )
+	{
+		if( table->models[i] == model )
+			return true;
+	}
+
+	if( table->count < COF_SPRITE_SEEN_MAX )
+		table->models[table->count++] = model;
+
+	return false;
+}
+
+/*
+================
+R_CoFSpriteFrame
+
+Returns the frame to hand on. With both cvars at 0 it is the raw request,
+untouched, which is the stock path.
+================
+*/
+static int R_CoFSpriteFrame( const cl_entity_t *ent, const msprite_t *psprite, const char *path )
+{
+	int	frame = (int)ent->curstate.frame;
+
+	if( frame >= 0 && frame < psprite->numframes )
+		return frame;
+
+	if( cof_sprite_trace.value && !R_CoFSpriteSeen( &cof_sprite_trace_seen, ent->model ))
+	{
+		gEngfuncs.Con_Printf( "[cof-sprite] %s requested frame %d numframes %d ent %d (%s) rendermode %d renderamt %d rendercolor %d,%d,%d scale %.3f framerate %.2f path %s\n",
+			ent->model->name, frame, psprite->numframes, ent->index,
+			ent->index > 0 ? "server entity" : "client entity",
+			ent->curstate.rendermode, ent->curstate.renderamt,
+			ent->curstate.rendercolor.r, ent->curstate.rendercolor.g, ent->curstate.rendercolor.b,
+			ent->curstate.scale, ent->curstate.framerate, path );
+	}
+
+	if( !cof_sprite_quiet_frames.value )
+		return frame;	// stock: whoever is called next clamps and logs
+
+	if( frame > 0 && !R_CoFSpriteSeen( &cof_sprite_warn_seen, ent->model ))
+	{
+		gEngfuncs.Con_DPrintf( S_WARN "no such frame %d (%s), clamped to %d; further out-of-range frames of this sprite are not logged (cof_sprite_quiet_frames 1)\n",
+			frame, ent->model->name, psprite->numframes - 1 );
+	}
+
+	return frame < 0 ? 0 : psprite->numframes - 1;
+}
