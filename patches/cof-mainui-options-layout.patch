+// Controls: aiming, mouse, gamepad
+// ---------------------------------------------------------------------------
+
+static const char *g_cofAdsModesC[] = { "Hold", "Toggle" };
+
+class CMenuCoFAdsModelC : public CMenuBaseArrayModel
+{
+public:
+	void Update() override { }
+	int GetRows() const override { return 2; }
