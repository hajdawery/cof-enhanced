+{
+	const char *label;		// through L()
+	const char *title;		// the page's own panel title (SetPanel)
+	void (*show)( void );
+	bool (*available)( void );	// NULL: always
+};
+
+struct cofTabGroup_t
+{
+	const char *title;		// drawn in the title band
+	const cofTab_t *tabs;
+	int count;
+};
+
