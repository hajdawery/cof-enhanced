+			THEME_TEXT_DIM, capH, QM_LEFT, ETF_FORCECOL | ETF_NO_WRAP | ETF_NOSIZELIMIT );
+		UI_ThemeSeparator( m_scPos.x, m_scPos.y + capH + (int)( 4 * uiStatic.scaleY ), m_scSize.w, THEME_SEPARATOR );
