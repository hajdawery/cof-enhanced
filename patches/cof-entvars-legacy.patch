diff --git a/wscript b/wscript
index 3158145..b3f2007 100644
--- a/wscript
+++ b/wscript
@@ -189,6 +189,9 @@ def options(opt):
 	grp.add_option('--enable-hl25-extended-structs', action = 'store_true', dest = 'SUPPORT_HL25_EXTENDED_STRUCTS', default = False,
