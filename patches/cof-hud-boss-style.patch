  memset( hud_ammo, 0, sizeof( hud_ammo ));
  for( int i=0; i<HUD_WEAPONS; i++ ) { hud_weapons[i].clip=-1; hud_weapons[i].reserve=0; }
  hud.clip = hud.stamina = hud.previous_health = -1;
