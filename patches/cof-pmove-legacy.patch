 	svgame.pmove->server = true;
 	svgame.pmove->movevars = &svgame.movevars;
@@ -488,7 +537,15 @@ void SV_InitClientMove( void )
 	svgame.pmove->PM_TraceSurface = pfnTraceSurface;
 
