+	cofLanguage.SetNameAndStatus( L( "Language" ), L( "Choose the subtitle and document language" ) );
+	cofLanguage.SetPicture( PC_CUSTOMIZE );
+	cofLanguage.iFlags |= QMF_NOTIFY;
