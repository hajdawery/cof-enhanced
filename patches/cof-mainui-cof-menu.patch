+
+	cofUnlockables.SetNameAndStatus( L( "Unlockables" ), L( "Open the unlockables gallery" ) );
+	cofUnlockables.SetPicture( PC_VIEW_GAME_INFO );
+	cofUnlockables.iFlags |= QMF_NOTIFY;
+	cofUnlockables.onReleased = UI_CoFUnlockables;
+
+	cofExtras.SetNameAndStatus( L( "Extras" ), L( "Soundtrack, merchandise and community links" ) );
+	cofExtras.SetPicture( PC_VISIT_WEB_SITE );
+	cofExtras.iFlags |= QMF_NOTIFY;
+	cofExtras.onReleased = UI_CoFExtras_Menu;
+
+	cofQuitToMenu.SetNameAndStatus( L( "Quit to menu" ), L( "Leave the game and return to the main menu" ) );
