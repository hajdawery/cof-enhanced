+		&cofHostServer, &cofLanguage, &cofUnlockables, &cofExtras,
+		&configuration, &cofQuitToMenu, &quit
+	};
+
+	int yoffset = 230;
+	for( size_t i = 0; i < sizeof( order ) / sizeof( order[0] ); i++ )
+	{
+		if( !order[i]->IsVisible( ))
+			continue;
+
+		order[i]->SetCoord( hoffset, yoffset );
+		yoffset += ygap;
+	}
+}
