+void CL_CoF_EnterOskDismiss( void )
+{
+	if( !cof_osk_dismiss_guard.value ) return;
+	cof_enter.pulse = false;
+	cof_enter.pulse_frame = -1;
+	cof_enter.held = false;
+	cof_enter.start_swallowed = false;
+	cof_enter.osk_release_return = Key_IsDown( K_ENTER ) || Key_IsDown( K_KP_ENTER );
+#if XASH_WIN32
+	if( GetAsyncKeyState( VK_RETURN ) & 0x8000 ) cof_enter.osk_release_return = true;
+#endif
+	if( Key_IsDown( K_ENTER )) cof_enter.osk_release_keys |= 1;
+	if( Key_IsDown( K_KP_ENTER )) cof_enter.osk_release_keys |= 2;
+	if( Key_IsDown( K_START_BUTTON )) cof_enter.osk_release_keys |= 4;
+}
 
