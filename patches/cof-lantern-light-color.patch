+// A black rendercolor is data, not tint, for the retail lantern effect.
+// Whitening it selects the custom-radius branch instead of the default light.
+static qboolean CL_CoFPreserveLanternColor( const cl_entity_t *ent )
+{
+	return cof_lantern_light_fix.value && !Q_stricmp( GI->gamefolder, "cryoffear" ) &&
+		ent->curstate.renderfx == 245;
