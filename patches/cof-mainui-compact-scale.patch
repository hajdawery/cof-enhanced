+// The gamepad5 keyboard already has its own compact geometry. Keep that
+// physical size when the rest of MainUI is reduced, including theme-drawn
+// title chrome, text metrics and mouse hit areas. Never accumulate scaling.
+class CCoFOskNativeScale
+{
+public:
+	CCoFOskNativeScale() : m_x( uiStatic.scaleX ), m_y( uiStatic.scaleY )
+	{
+		if( Depth()++ == 0 )
+		{
+			const float applied = UI_ThemeMenuScaleApplied();
+			uiStatic.scaleX /= applied;
+			uiStatic.scaleY /= applied;
+		}
+	}
+	~CCoFOskNativeScale() { --Depth(); uiStatic.scaleX = m_x; uiStatic.scaleY = m_y; }
+private:
+	static int &Depth() { static int depth = 0; return depth; }
+	float m_x, m_y;
+};
 
