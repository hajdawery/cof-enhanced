+
 int XashSurface::applyTextYTarget( void )
 {
 	if( !runIsMessage( ))
 		return 0;
 
+	// Each label flushes separately. Moving every run to the same target made
+	// simultaneous phone/objective captions overwrite one another (issue #2).
+	// Reserve the entire visible run, including backing padding, for this paint.
+	// Later labels stack above it; a wrapped label keeps its internal spacing.
+	bool visible = false;
+	for( int i = 0; i < backingGlyphCount; i++ )
+		visible = visible || backingGlyphs[i].color[3] < 255;
+	if( !visible ) return 0;
+
+	int top = backingLines[0].y, bottom = top;
+	for( int i = 0; i < backingLineCount; i++ )
+	{
+		const BackingLine &line = backingLines[i];
+		int pad = Q_max( 1, line.tall / 6 );
+		top = Q_min( top, line.y - pad );
+		bottom = Q_max( bottom, line.y + line.tall + pad );
+	}
 	int delta = CofUI_ToLayoutY( textYTarget ) - backingLines[0].y;
+	if( messageStackUsed && bottom + delta >= messageStackTop )
+		delta = messageStackTop - Q_max( 1, backingLines[0].tall / 6 ) - bottom;
+	messageStackTop = top + delta;
+	messageStackUsed = true;
 
 	if( delta == 0 )
 		return 0;
